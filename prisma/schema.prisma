generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  agency       Agency?
  sessions     Session[]
  onboarding   OnboardingDraft?
  agencyDrafts AgencyDraft[]
  engineState  AgencyEngineState?
}

model Agency {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  ownerId     String   @unique
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  currency       String @default("USD")
  timezone       String @default("UTC")
  positioning    String @default("")
  buyer          String @default("")
  practices      Json   @default(dbgenerated("'[]'"))
  goal           String @default("")
  weeklyCapacityHours Float?
  sampleWorkspace Boolean @default(false)
  acceptedDraftId String? @unique
  acceptanceKey  String? @unique
  version        Int @default(1)
  packages       ServicePackage[]
  clients        Client[]
  projects       Project[]
  tasks          Task[]
  evidence       EvidenceItem[]
  actuals        FinancialActualPeriod[]
  snapshots      FinanceSnapshot[]
  exports        ExportSnapshot[]
  checklist      DataRoomItem[]
  events         ActivityEvent[]
  engineState    AgencyEngineState?
  automationState AutomationState?
  rolesAndWorkflows Json @default(dbgenerated("'{}'"))
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Shared across app processes; stores a hashed account identifier, never a password.
model AuthThrottle {
  key       String   @id
  attempts  Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model OnboardingDraft {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  data Json
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model AgencyDraft {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  onboardingVersion Int
  content Json
  providerVersion String
  templateVersion String
  inputHash String
  status String @default("generated")
  version Int @default(1)
  acceptedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, createdAt])
}
model AgencyEngineState {
  id String @id
  user User @relation(fields: [id], references: [id], onDelete: Cascade)
  agencyId String? @unique
  agency Agency? @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  version Int @default(0)
  payload String @default(dbgenerated("'{}'"))
  updatedAt DateTime @updatedAt
}
model AutomationState {
  agencyId String @id
  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  version Int @default(0)
  stateJson String @default(dbgenerated("'{}'"))
  updatedAt DateTime @updatedAt
}
model ServicePackage {
  id String @id @default(cuid())
  agencyId String
  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  title String
  deliverables Json
  exclusions Json
  revisionLimit Int
  turnaroundDays Int
  laborHours Float
  priceMinor Int
  currency String @default("USD")
  freeSample Boolean @default(false)
  pricingBasis Json
  sopVersion String?
  sopCreatedAt DateTime?
  acceptanceChecklist Json @default(dbgenerated("'[]'"))
  archivedAt DateTime?
  draft Boolean @default(false)
  version Int @default(1)
  projects Project[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([agencyId, archivedAt])
}
model Client {
  id String @id @default(cuid())
  agencyId String
  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  economicGroupId String
  name String
  organization String @default("")
  contactEmail String?
  note String @default("")
  archivedAt DateTime?
  version Int @default(1)
  projects Project[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([agencyId, archivedAt])
  @@index([agencyId, economicGroupId])
}
model Project {
  id String @id @default(cuid())
  agencyId String
  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  clientId String?
  client Client? @relation(fields: [clientId], references: [id], onDelete: NoAction)
  packageId String?
  package ServicePackage? @relation(fields: [packageId], references: [id], onDelete: NoAction)
  title String
  brief String @default("")
  status String @default("planned")
  dueAt DateTime?
  budgetMinor Int?
  archivedAt DateTime?
  completedAt DateTime?
  version Int @default(1)
  tasks Task[]
  closeout ProjectCloseout?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([agencyId, status, archivedAt])
}
model Task {
  id String @id @default(cuid())
  agencyId String
  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  projectId String?
  project Project? @relation(fields: [projectId], references: [id], onDelete: NoAction)
  title String
  input String @default("")
  assignedRoleKey String?
  status String @default("queued")
  priority String @default("normal")
  dueAt DateTime?
  originalCommittedDueAt DateTime?
  dueDateHistory Json @default(dbgenerated("'[]'"))
  acceptedAt DateTime?
  cancellationRecord Json?
  approvedArtifact Json?
  reviewNeeded Boolean @default(true)
  version Int @default(1)
  predecessors TaskDependency[] @relation("dependent")
  successors TaskDependency[] @relation("predecessor")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([agencyId, status, dueAt])
}
model TaskDependency {
  taskId String
  predecessorId String
  task Task @relation("dependent", fields: [taskId], references: [id], onDelete: Cascade)
  predecessor Task @relation("predecessor", fields: [predecessorId], references: [id], onDelete: NoAction)
  @@id([taskId, predecessorId])
}
model ProjectCloseout {
  projectId String @id
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agencyId String
  deliveryDate DateTime
  recognizedRevenueMinor Int?
  receiptsMinor Int?
  deliveryCostMinor Int?
  founderLaborHours Float?
  founderCostTreatment String
  repeatabilityNotes String
  recurrenceType String
  provenance Json
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([agencyId, deliveryDate])
}
model FinancialActualPeriod {
  id String @id @default(cuid())
  agencyId String
  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  yearMonth String
  currency String @default("USD")
  sourceMode String
  data Json
  provenance Json
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([agencyId, yearMonth])
}
model EvidenceItem {
  id String @id @default(cuid())
  agencyId String
  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  category String
  metricKey String
  value Json
  provenance Json
  sourceRecordId String?
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([agencyId, sourceRecordId, metricKey])
  @@index([agencyId, category])
}
// Immutable calculation input and output revisions. Never update a snapshot.
model FinanceSnapshot {
  id String @id @default(cuid())
  agencyId String
  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  kind String
  formulaVersion String
  asOf DateTime
  evaluatedAt DateTime
  input Json
  output Json
  provenance Json
  createdAt DateTime @default(now())
  @@index([agencyId, kind, createdAt])
}
model DataRoomItem {
  id String @id @default(cuid())
  agencyId String
  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  category String
  title String
  state String @default("missing")
  note String
  sourceUrl String?
  evidenceIds Json
  period String?
  reviewedAt DateTime?
  ownerLabel String
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([agencyId, category])
}
model ExportSnapshot {
  id String @id @default(cuid())
  agencyId String
  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  idempotencyKey String
  manifest Json
  markdown String
  csv String
  createdAt DateTime @default(now())
  @@unique([agencyId, idempotencyKey])
}
model ActivityEvent {
  id String @id @default(cuid())
  agencyId String
  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  actorUserId String
  kind String
  subjectId String
  correlationKey String
  metadata Json
  createdAt DateTime @default(now())
  @@unique([agencyId, correlationKey])
  @@index([agencyId, createdAt])
}
